---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Testimonials from '../../components/Testimonials.astro';
import MailtoForm from '../../components/MailtoForm.astro';
import { fill, getPage, getSite, getUi, html, inlineHtml, sized } from '../../lib/cms';
import { url } from '../../lib/url';

const page = await getPage('commissionsPage');
const { packPdf } = await getSite();
const ui = await getUi();
---

<Base title={page.seoTitle} description={page.seoDescription}>
  <section class="page-hero hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">{page.heroEyebrow}</p>
        <h1>{page.heroHeading}</h1>
        <p>{page.heroText}</p>
        <p class="hero__cta">
          <a class="btn btn--peach" href={packPdf} target="_blank" rel="noopener noreferrer">
            {page.pdfButton}<span class="sr-only"> {ui.newTabHint}</span>
          </a>
          <a class="btn btn--ghost-light" href="#presupuesto">{page.quoteButton}</a>
        </p>
      </div>
      <Image {...sized(page.heroImage, 560)} alt={page.heroImageAlt} class="hero__img" loading="eager" />
    </div>
  </section>

  <section class="section pitch">
    <div class="wrap prose">
      <h2>{page.pitchHeading}</h2>
      <Fragment set:html={html(page.pitchBody)} />
    </div>
  </section>

  <section class="section services" aria-labelledby="servicios-title">
    <div class="wrap">
      <h2 id="servicios-title">{page.servicesHeading}</h2>
      <ul class="cards">
        {
          page.services.map((s: { title: string; price: string; items: string[]; buttonLabel: string }) => (
            <li class="card">
              <h3>{s.title}</h3>
              <p class="price">{s.price}</p>
              <ul class="features">{s.items.map((i) => <li>{i}</li>)}</ul>
              <a class="btn btn--ghost" href={packPdf} target="_blank" rel="noopener noreferrer">
                {s.buttonLabel}<span class="sr-only"> {fill(ui.pdfNewTabAbout, { title: s.title })}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="pack">
        <div class="pack__media">
          <Image {...sized(page.packCover, 520)} alt={page.packCoverAlt} />
          <Image {...sized(page.packInterior, 520)} alt={page.packInteriorAlt} />
        </div>
        <div class="pack__body">
          <p class="eyebrow">{page.packEyebrow}</p>
          <p class="pack__lead" set:html={inlineHtml(page.packLead)} />
          <h3>{page.packTitle}</h3>
          <p class="price">{page.packPrice}</p>
          <ul class="features">{page.packItems.map((i: string) => <li>{i}</li>)}</ul>
          <a class="btn" href={packPdf} target="_blank" rel="noopener noreferrer">
            {page.packButton}<span class="sr-only"> {ui.pdfNewTabPack}</span>
          </a>
        </div>
      </div>

      <p class="other">
        <a class="btn btn--ghost" href={url('/comisiones/ilustracion-personalizada')}>{page.otherLink}</a>
      </p>
    </div>
  </section>

  <section class="section quote" id="presupuesto" aria-labelledby="presupuesto-title">
    <div class="wrap quote__grid">
      <div>
        <h2 id="presupuesto-title">{page.quoteHeading}</h2>
        <p>{page.quoteText}</p>
        <p class="quote__big">{page.quoteBig}</p>
      </div>
      <div class="quote__form">
        <h3>{page.quoteFormTitle}</h3>
        <MailtoForm variant="quote" id="presupuesto-form" />
      </div>
    </div>
  </section>

  <section class="section terms" aria-labelledby="terms-title">
    <div class="wrap prose">
      <h2 id="terms-title">{page.termsHeading}</h2>
      {
        page.terms.map((t: { title: string; open?: boolean; body: unknown[] }) => (
          <details open={t.open}>
            <summary>{t.title}</summary>
            <Fragment set:html={html(t.body)} />
          </details>
        ))
      }
    </div>
  </section>

  <Testimonials items={page.testimonials} id="opiniones-comisiones" />
</Base>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__img {
    justify-self: center;
    width: min(100%, 420px);
    border-radius: 16px;
    box-shadow: 0 20px 44px rgb(0 0 0 / 0.3);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }
  .btn--ghost-light {
    background: transparent;
    border-color: var(--cream);
    color: var(--cream);
  }
  .btn--ghost-light:hover {
    background: var(--cream);
    color: var(--sage-dark);
    border-color: var(--cream);
  }

  .pitch {
    background: var(--cream);
    text-align: center;
  }
  .pitch .prose :global(p) {
    margin-inline: auto;
  }

  .services {
    background: var(--sand);
  }
  .services > .wrap > h2 {
    text-align: center;
    margin-bottom: 2rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: #fff;
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 8px 22px rgb(42 37 35 / 0.1);
  }
  .card .btn {
    margin-top: auto;
    align-self: start;
  }
  .price {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--terracotta-dark);
    margin: 0;
  }
  .features {
    margin-bottom: 1rem;
  }
  .features li {
    padding-left: 1.6rem;
    margin-bottom: 0.4rem;
    position: relative;
  }
  .features li::before {
    content: '🍂';
    position: absolute;
    left: 0;
    font-size: 0.95em;
  }

  .pack {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    margin-top: 3.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--peach);
    border-radius: 20px;
  }
  .pack__media {
    display: grid;
    gap: 1rem;
  }
  .pack__media :global(img) {
    border-radius: 12px;
    box-shadow: 0 10px 24px rgb(42 37 35 / 0.25);
  }
  .pack__lead {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .pack .eyebrow {
    color: var(--terracotta-dark);
  }
  .other {
    text-align: center;
    margin: 2.5rem 0 0;
  }

  .quote {
    background: var(--terracotta-dark);
    color: var(--cream);
  }
  .quote__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .quote__big {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    color: var(--peach);
  }
  .quote__form {
    background: var(--sand);
    color: var(--ink);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 16px;
  }

  .terms {
    background: var(--cream);
  }
  details {
    border-bottom: 1px solid rgb(42 37 35 / 0.2);
    padding-block: 0.9rem;
  }
  summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.25rem;
    padding-block: 0.25rem;
  }
  details[open] summary {
    margin-bottom: 0.75rem;
    color: var(--terracotta-dark);
  }
  details :global(ul) {
    list-style: disc;
    padding-left: 1.4rem;
    margin-bottom: 1em;
  }

  @media (max-width: 860px) {
    .hero__grid,
    .pack,
    .quote__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
