---
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import Gallery from '../../components/Gallery.astro';
import { getArtworksOf, getProjects, html, plainText, type Project } from '../../lib/cms';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const items = await getArtworksOf(project.slug);
const heading = project.hashtag ?? project.title;
---

<Base title={project.title} description={plainText(project.intro.slice(0, 1)).slice(0, 155)}>
  <section class="page-hero page-hero--terracotta">
    <div class="wrap">
      <p class="eyebrow"><a href={url('/proyectos')}>← Proyectos</a></p>
      <h1>{heading}</h1>
      <div class="intro">
        <Fragment set:html={html(project.intro)} />
        {project.note && <p><em>({project.note})</em></p>}
      </div>
    </div>
  </section>

  <section class="section gallery-section">
    <div class="wrap">
      <Gallery items={items} id={`galeria-${project.slug}`} />
    </div>
  </section>
</Base>

<style>
  .eyebrow a {
    text-decoration: none;
  }
  .eyebrow a:hover {
    text-decoration: underline;
  }
  .intro {
    max-width: 70ch;
  }
  .gallery-section {
    background: var(--sand);
  }
</style>
