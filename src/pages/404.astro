---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" noindex>
  <section class="nf">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1>Esta página se ha perdido en el bosque</h1>
      <p>El enlace que buscas ya no existe o se ha movido.</p>
      <p><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>

<style>
  .nf {
    background: var(--sand);
    padding: calc(var(--nav-h) + 5rem) 0 6rem;
    text-align: center;
    min-height: 70vh;
  }
</style>
