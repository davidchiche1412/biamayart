---
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/cms';
import { url } from '../lib/url';

const page = await getPage('notFoundPage');
---

<Base title={page.seoTitle} noindex>
  <section class="nf">
    <div class="wrap">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.heading}</h1>
      <p>{page.text}</p>
      <p><a class="btn" href={url('/')}>{page.buttonLabel}</a></p>
    </div>
  </section>
</Base>

<style>
  .nf {
    background: var(--sand);
    padding: calc(var(--nav-h) + 5rem) 0 6rem;
    text-align: center;
    min-height: 70vh;
  }
</style>
