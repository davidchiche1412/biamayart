---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getPage, html, sized } from '../lib/cms';
import { url } from '../lib/url';

const page = await getPage('aboutPage');
---

<Base title={page.seoTitle} description={page.seoDescription}>
  <section class="about">
    <Image {...sized(page.backdrop, 1600)} alt="" class="about__bg" loading="eager" />
    <div class="wrap about__grid">
      <div class="about__text">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.heading}</h1>
        <Fragment set:html={html(page.body)} />
        <p class="about__cta">
          <a class="btn" href={url('/proyectos')}>{page.ctaProjects}</a>
          <a class="btn btn--ghost" href={url('/contacto')}>{page.ctaContact}</a>
        </p>
      </div>
      <Image {...sized(page.portrait, 640)} alt={page.portraitAlt} class="about__photo" loading="eager" />
    </div>
  </section>

  <section class="career section" aria-labelledby="career-title">
    <div class="wrap">
      <h2 id="career-title">{page.careerTitle}</h2>
      <ol class="timeline">
        {
          page.career.map((c: { period: string; role: string; company: string; text: string }) => (
            <li>
              <p class="timeline__period">{c.period}</p>
              <div>
                <h3>
                  {c.role} <span>({c.company})</span>
                </h3>
                <p>{c.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .about {
    position: relative;
    overflow: hidden;
    padding: calc(var(--nav-h) + 3rem) 0 4rem;
    background: var(--sand);
    isolation: isolate;
  }
  .about__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(22px) saturate(0.8);
    opacity: 0.35;
    z-index: -1;
  }
  .about__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .about__text h1 {
    color: var(--terracotta-dark);
  }
  .about__photo {
    width: 100%;
    max-width: 460px;
    justify-self: center;
    border-radius: 24px;
    box-shadow: 0 24px 50px rgb(42 37 35 / 0.3);
  }
  .about__cta {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
  .career {
    background: var(--peach);
  }
  .career h2 {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .timeline {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 980px;
    display: grid;
    gap: 2.5rem;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(42 37 35 / 0.3);
  }
  .timeline li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .timeline__period {
    font-weight: 600;
    color: var(--ink);
    margin: 0;
  }
  .timeline h3 span {
    font-weight: 400;
    font-size: 0.85em;
  }
  @media (max-width: 800px) {
    .about__grid,
    .timeline li {
      grid-template-columns: 1fr;
    }
    .timeline li {
      gap: 0.5rem;
    }
  }
</style>
