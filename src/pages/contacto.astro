---
import Base from '../layouts/Base.astro';
import MailtoForm from '../components/MailtoForm.astro';
import { getPage, getSite } from '../lib/cms';

const page = await getPage('contactPage');
const { email } = await getSite();
---

<Base title={page.seoTitle} description={page.seoDescription}>
  <section class="page-hero page-hero--terracotta">
    <div class="wrap">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.heading}</h1>
      <p>
        {page.intro}
        <span> <a href={`mailto:${email}`}>{email}</a></span>.
      </p>
    </div>
  </section>

  <section class="section contact">
    <div class="wrap contact__box">
      <MailtoForm variant="contact" id="contacto" />
    </div>
  </section>
</Base>

<style>
  .contact {
    background: var(--sand);
  }
  .contact__box {
    max-width: 720px;
  }
  .page-hero a {
    color: #fff;
    text-decoration: underline;
  }
</style>
