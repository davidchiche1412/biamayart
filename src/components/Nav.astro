---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import avatar from '../assets/brand/3e17b3.jpg';
import Icon from './Icon.astro';
import { nav, socials } from '../data/site';
import { stripBase, url } from '../lib/url';

const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a href={url('/')} class="nav__brand" aria-label="Biamay Art, ir a inicio">
      <Image src={avatar} alt="" width={96} height={96} class="nav__avatar" loading="eager" />
      <Image src={logo} alt="Biamay Art" width={260} class="nav__logo" loading="eager" />
    </a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
      <span class="sr-only">Abrir menú</span>
      <span data-icon-open><Icon name="menu" size={26} /></span>
      <span data-icon-close hidden><Icon name="close" size={26} /></span>
    </button>

    <nav id="nav-menu" class="nav__menu" aria-label="Principal" data-nav-menu>
      <ul class="nav__links">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.external ? item.href : url(item.href)}
                aria-current={!item.external && isActive(item.href) ? 'page' : undefined}
                {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.label}
                {item.external && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="nav__social" aria-label="Redes sociales">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                <Icon name={s.icon} size={20} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition: height 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease, transform 0.35s ease;
  }
  :global(html[data-immersive]) .nav {
    transform: translateY(-100%);
  }
  .nav.is-compact {
    --nav-h: 56px;
    box-shadow: 0 2px 18px rgb(42 37 35 / 0.12);
    border-color: rgb(42 37 35 / 0.08);
  }
  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--peach);
    transition: width 0.25s, height 0.25s;
  }
  .nav.is-compact .nav__avatar {
    width: 36px;
    height: 36px;
  }
  .nav__logo {
    width: 150px;
    height: auto;
    transition: width 0.25s;
  }
  .nav.is-compact .nav__logo {
    width: 124px;
  }
  .nav__menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav__links {
    display: flex;
    gap: 1.75rem;
  }
  .nav__links a {
    position: relative;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink-soft);
    padding-block: 0.4rem;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--terracotta);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s;
  }
  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: var(--ink);
  }
  .nav__links a:hover::after,
  .nav__links a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav__social {
    display: flex;
    gap: 0.85rem;
    padding-left: 1.5rem;
    border-left: 1px solid rgb(42 37 35 / 0.2);
  }
  .nav__social a {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: var(--ink);
    transition: color 0.2s, transform 0.2s;
  }
  .nav__social a:hover {
    color: var(--terracotta);
    transform: translateY(-2px);
  }
  .nav__toggle {
    display: none;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    padding: 0.4rem;
  }

  @media (max-width: 900px) {
    .nav__toggle {
      display: block;
    }
    .nav__menu {
      position: fixed;
      inset: var(--nav-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.5rem 1.5rem 2rem;
      background: var(--cream);
      border-bottom: 1px solid rgb(42 37 35 / 0.12);
      box-shadow: 0 16px 24px rgb(42 37 35 / 0.12);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
    }
    .nav__menu.is-open {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav__links {
      flex-direction: column;
      gap: 0.25rem;
    }
    .nav__links a {
      display: block;
      font-size: 1.15rem;
      padding-block: 0.6rem;
    }
    .nav__social {
      padding: 1rem 0 0;
      border-left: 0;
      border-top: 1px solid rgb(42 37 35 / 0.15);
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const toggle = nav.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
  const menu = nav.querySelector<HTMLElement>('[data-nav-menu]')!;
  const iconOpen = toggle.querySelector<HTMLElement>('[data-icon-open]')!;
  const iconClose = toggle.querySelector<HTMLElement>('[data-icon-close]')!;

  const setOpen = (open: boolean) => {
    menu.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    iconOpen.hidden = open;
    iconClose.hidden = !open;
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.classList.contains('is-open')) {
      setOpen(false);
      toggle.focus();
    }
  });

  const onScroll = () => nav.classList.toggle('is-compact', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
