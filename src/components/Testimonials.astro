---
import Icon from './Icon.astro';
import type { Testimonial } from '../data/testimonials';

interface Props {
  items: Testimonial[];
  heading?: string;
  id?: string;
}
const { items, heading = 'Opiniones de clientes', id = 'opiniones' } = Astro.props;
---

<section class="testimonials section" aria-labelledby={`${id}-title`} data-carousel>
  <div class="wrap">
    <h2 id={`${id}-title`}>{heading}</h2>

    <div class="carousel" role="group" aria-roledescription="carrusel" aria-label={heading}>
      <ul class="slides">
        {
          items.map((t, i) => (
            <li
              class="slide"
              aria-label={`${i + 1} de ${items.length}`}
              hidden={i !== 0}
              data-slide
            >
              <figure>
                <blockquote>
                  <p>{t.quote}</p>
                </blockquote>
                <figcaption>
                  {t.href ? (
                    <a href={t.href} target="_blank" rel="noopener noreferrer">
                      {t.author}
                    </a>
                  ) : (
                    <strong>{t.author}</strong>
                  )}
                  {t.role && <span> · {t.role}</span>}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>

      {
        items.length > 1 && (
          <div class="controls">
            <button type="button" class="ctrl ctrl--prev" data-prev aria-label="Opinión anterior">
              <Icon name="arrow" />
            </button>
            <div class="dots" aria-hidden="true">
              {items.map((_, i) => <span class:list={['dot', { 'is-on': i === 0 }]} data-dot />)}
            </div>
            <button type="button" class="ctrl" data-next aria-label="Opinión siguiente">
              <Icon name="arrow" />
            </button>
          </div>
        )
      }
      <p class="sr-only" aria-live="polite" data-live></p>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--terracotta-dark);
    color: var(--cream);
  }
  h2 {
    text-align: center;
    margin-bottom: 2rem;
  }
  .carousel {
    max-width: 820px;
    margin-inline: auto;
    background: var(--sage-dark);
    border-radius: 18px;
    padding: clamp(1.75rem, 5vw, 3.5rem);
    position: relative;
  }
  .slides {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .slide {
    animation: fade 0.4s ease;
  }
  figure {
    margin: 0;
  }
  blockquote {
    margin: 0;
    position: relative;
    padding-top: 2.5rem;
  }
  blockquote::before {
    content: '“';
    position: absolute;
    top: -0.35rem;
    left: -0.1rem;
    font: 5rem/1 var(--font-display);
    color: var(--peach);
  }
  blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    line-height: 1.55;
  }
  figcaption {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: #e6dfcf;
  }
  figcaption a,
  figcaption strong {
    color: #fff;
    font-weight: 600;
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
  }
  .ctrl {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px solid var(--cream);
    background: transparent;
    color: var(--cream);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .ctrl:hover {
    background: var(--cream);
    color: var(--sage-dark);
  }
  .ctrl--prev :global(svg) {
    transform: scaleX(-1);
  }
  .dots {
    display: flex;
    gap: 0.5rem;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgb(243 238 227 / 0.4);
    transition: background 0.2s, transform 0.2s;
  }
  .dot.is-on {
    background: var(--peach);
    transform: scale(1.3);
  }
  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    let index = 0;

    const show = (next: number, announce = true) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => (s.hidden = i !== index));
      dots.forEach((d, i) => d.classList.toggle('is-on', i === index));
      if (announce) live.textContent = `Opinión ${index + 1} de ${slides.length}`;
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  });
</script>
